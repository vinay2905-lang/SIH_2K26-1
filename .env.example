# Copy to .env and replace every value before running `docker compose up`.

# PostgreSQL password for the `pramaan` database user
POSTGRES_PASSWORD=change-me

# 32-byte key, urlsafe base64 — documents are encrypted at rest with AES-256-GCM. Generate with:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PRAMAAN_STORAGE_KEY=

# Token signing secret, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PRAMAAN_JWT_SECRET=

# Optional
# PRAMAAN_HTTP_PORT=8080
# PRAMAAN_CORS_ORIGINS=http://localhost:8080
